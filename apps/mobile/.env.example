# Copy to .env.local. On a phone, 127.0.0.1 means the phone itself, so use your laptop's
# Wi-Fi IP address instead (run `ipconfig` on Windows), for example http://192.168.1.20:54321
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# ANON_KEY from `npx supabase status -o env` (or the anon / publishable key of the live project)
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Website, for the policy and contact pages
EXPO_PUBLIC_SITE_URL=http://127.0.0.1:3000
