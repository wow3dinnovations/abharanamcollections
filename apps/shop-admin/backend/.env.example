# Copy this file to ".env" (the app also creates .env automatically on first start).
# Do NOT put business data here. Do NOT share or commit your .env file.

# Secret used to sign login sessions. Generated automatically on first start if empty.
SECRET_KEY=

# Where the web server listens. 127.0.0.1 = only this computer can open the app.
HOST=127.0.0.1
PORT=8000

# Login session length in hours
SESSION_HOURS=12

# Automatic backup: how often (hours) and how many automatic backups to keep
AUTO_BACKUP_HOURS=12
AUTO_BACKUP_KEEP=30

# Optional: change where the data folders live (default = project folder)
# ABH_BASE_DIR=E:/Abharanam

# Set to 1 ONLY when the app is used through https:// (online). Keep off for http://localhost
# COOKIE_SECURE=1

# ---- Customer website (1gram.abharanamcollections.com) ----
# Fill these to publish products, prices, stock and photos to the website and app.
# Supabase -> Project Settings -> API Keys -> service_role (or Secret) key. Keep it secret:
# it is only ever used on this computer and must never be put on the website or in git.
WEBSITE_SUPABASE_URL=
WEBSITE_SUPABASE_SERVICE_KEY=
# Publish changes automatically every N minutes (0 = only when you press "Publish now")
WEBSITE_SYNC_MINUTES=5
# Shown as a link on the Website page
WEBSITE_PUBLIC_URL=https://1gram.abharanamcollections.com
