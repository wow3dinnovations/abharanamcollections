# secrets / environment
.env
backend/.env
*.pem

# python
backend/.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/

# node
frontend/node_modules/
frontend/dist/

# REAL business data - never commit
data/*.json
data/.*
