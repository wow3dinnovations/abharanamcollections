barcode_labels/*
exports/*
logs/*

# keep the empty folders in git
!data/.gitkeep
!backups/.gitkeep
!uploads/products/.gitkeep
!uploads/expenses/.gitkeep
!uploads/imports/.gitkeep
!invoices/.gitkeep
!barcode_labels/.gitkeep
!exports/.gitkeep
!logs/.gitkeep

# never allow any SQL database file
*.db
*.sqlite
*.sqlite3

# OS / editor / temp
.DS_Store
Thumbs.db
*.log
*.tmp
.vscode/
